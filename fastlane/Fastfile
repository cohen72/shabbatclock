# Fastlane lanes for the Delicious Kitchen — the entire build/sign/submit/distribute path.
# Portable: reads everything from environment variables (see ../.env).
# No personal tooling; this is the standard open-source Fastlane ecosystem.

default_platform(:ios)

# App Store Connect API key (used by every lane that talks to Apple).
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_P8_PATH"],
    in_house: false
  )
end

platform :ios do
  desc "Upload metadata only (no binary) and don't submit"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Build a signed release .ipa with gym (automatic signing via ASC API key)"
  lane :build do
    gym(
      project: ENV["APP_XCODEPROJ"],
      scheme: ENV["APP_SCHEME"],
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{File.expand_path(ENV['ASC_KEY_P8_PATH'])} " \
              "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
              "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
    )
  end

  desc "Build and upload to TestFlight (distribution)"
  lane :beta do
    build
    pilot(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Submit the already-uploaded binary for review (no rebuild/reupload)"
  lane :submit do
    deliver(
      api_key: asc_api_key,
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: true,
      force: true,                       # skip the HTML preview prompt
      automatic_release: false,          # you press 'Release' after approval
      run_precheck_before_submit: false, # precheck can't check IAPs via API key auth
      submission_information: {
        add_id_info_uses_idfa: false     # ShabbatClock does not use IDFA/ads
      }
    )
  end

  desc "Build, upload binary, and submit for review (no metadata/screenshots changes)"
  lane :release do
    build
    deliver(
      api_key: asc_api_key,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      force: true,                       # skip the HTML preview prompt
      automatic_release: false,          # you press 'Release' after approval
      run_precheck_before_submit: false, # precheck can't check IAPs via API key auth
      submission_information: {
        add_id_info_uses_idfa: false     # ShabbatClock does not use IDFA/ads
      }
    )
  end
end
